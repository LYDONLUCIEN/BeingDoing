    {
      "role": "user",
      "content": "我觉得需要包涵上 需要反馈的这件事",
      "thread_id": "t_759b2e7d6c7e47539a5d3d1a757d005a",
      "activation_session_id": "5ae90647-81a6-4af5-bda3-e2a51710fbc6",
      "step_id": "purpose",
      "filter_step": null,
      "agent_id": null,
      "event": "user_message",
