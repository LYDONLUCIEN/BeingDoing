# ==========================================================
# BeingDoing 环境变量（统一配置中心）
# 说明：
# 1) 当前后端默认使用 DeepSeek（推荐先只启用一个供应商，避免串用导致 401）
# 2) 未来可切换 GLM/Kimi/Claude/OpenAI，本文件已预留分组
# 3) 当前代码真正读取的是：LLM_PROVIDER / LLM_BASE_URL / LLM_MODEL / 对应 API KEY
# ==========================================================

# =========================
# 应用基础配置
# =========================
APP_ENV=production
DEBUG=False
DEBUG_MODE=True
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 超级管理员（逗号分隔）
SUPER_ADMIN_USER_IDS=
SUPER_ADMIN_EMAILS=q510971228@gmail.com,q510971228@163.com

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./app.db

# 架构模式：simple | full
ARCHITECTURE_MODE=simple


# =========================
# 默认大模型（当前生效）
# =========================
# 当前代码支持：
# - deepseek（推荐）
# - openai（或 OpenAI 兼容网关）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-reasoner
DEEPSEEK_API_KEY=sk-3bb837da57804a368cad2f5400b3f389


# VIP1（默认）
LLM_VIP1_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-3bb837da57804a368cad2f5400b3f389

# VIP2（可选）
LLM_VIP2_PROVIDER=kimi
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 设置最多并发
LLM_MAX_CONCURRENT=2

# 关闭未使用的 OpenAI，避免误命中导致 401
OPENAI_API_KEY=


# =========================
# 未来扩展模型（预留，不会被当前后端直接读取）
# 如需启用，请在代码中增加 provider 映射
# =========================
# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- GLM（智谱）---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- Kimi（月之暗面）---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# --- Claude（Anthropic）---
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-5-sonnet-20241022


# =========================
# 语音配置（可选）
# =========================
AUDIO_MODE=False
ASR_PROVIDER=openai
OPENAI_WHISPER_API_KEY=
TTS_PROVIDER=openai
OPENAI_TTS_API_KEY=


# =========================
# SMTP 邮件配置（忘记密码验证码）
# 163 邮箱示例：smtp.163.com + 465 + SSL
# 注意：SMTP_PASS 填写的是“客户端授权码”，不是邮箱登录密码
# =========================
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=soulhappylab@163.com
SMTP_PASS=DBkX655qiwmuN3YU
SMTP_FROM_EMAIL=soulhappylab@163.com
SMTP_FROM_NAME=ZhiYin
SMTP_USE_SSL=True
SMTP_USE_TLS=False
SMTP_TIMEOUT_SECONDS=20


# =========================
# 引导与缓存策略
# =========================
GUIDE_IDLE_TIMEOUT=600
GUIDE_QUIET_TIMEOUT=900
GUIDE_SHORT_ANSWER_THRESHOLD=20

GRAPH_CACHE_ENABLED=True
GRAPH_CACHE_TTL_MINUTES=15
GRAPH_CACHE_MAX_SIZE=20
GRAPH_CACHE_CLEANUP_INTERVAL_MINUTES=5

FULL_CONTEXT_ENABLED=True
CONTEXT_COMPRESS_AFTER_ROUNDS=5
CONTEXT_KEEP_LATEST_MESSAGES=3
CONTEXT_MAX_TOKEN_BUDGET=8000


# =========================
# 前端与启动模式
# =========================
# 留空表示同域 /api（生产推荐）
NEXT_PUBLIC_API_URL=
# start.sh: dev | production
FRONTEND_MODE=production