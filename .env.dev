# ==========================================================
# 开发环境覆盖配置
# 用法: ./start.sh start dev
# 加载顺序: .env (base) → .env.dev (覆盖)
# ==========================================================

APP_ENV=development
DEBUG=True
DEBUG_MODE=True

# 数据库（SQLite 本地开发）
DATABASE_URL=sqlite+aiosqlite:///./app.db

# DeepSeek Key（可选覆盖）：留空 = 继承 .env 的测试 key；
# 如需为本环境单独换 key 在此填写（2026-08-19 起测试/生产 key 完全隔离）
# DEEPSEEK_API_KEY=

# 前端
# 双域名并存：career.soulhappylab.com / career.beyondego.me 均可访问，此处为对外链接（邮件等）使用的主域名
FRONTEND_URL=https://career.beyondego.me
# 显式指向 dev 域名的后端，避免同源 /api 在反代/缓存链路里走错
# 本地开发时留空，让 Next.js dev server 通过 rewrites 代理到本地后端 8000
NEXT_PUBLIC_API_URL=
FRONTEND_MODE=dev

# Admin 调试
ADMIN_DEBUG_POLICY_ENABLED=True
ADMIN_DEBUG_WORKSPACE_ENABLED=True
ADMIN_SANDBOX_ENABLED=True

# 退信扫描（IMAP 配置继承 .env，cron 略调到非生产高峰）
BOUNCE_SCAN_CRON="0 3 * * *"

# 维护模式（maintenance.sh 使用）
# nginx 配置一次性加好（见 plan vivid-mapping-sunrise），脚本只切 flag
# 注意：1Panel OpenResty 是容器，宿主机 /opt/1panel/.../www 映射到容器 /www
# nginx 配置里写 /www/sites/zhiyinapp/...（容器视角），脚本写文件用宿主机路径
#
# ⚠️ 容器名 dev/prod 不同：
#   - dev 机（本文件）：1Panel-openresty-hjWm
#   - prod 机（.env.prod）：1Panel-openresty-UpQ6
# 如果此处留空，maintenance.sh 会自动探测 docker ps 里的 1Panel-openresty-* 容器
MAINTENANCE_FLAG_PATH=/opt/1panel/apps/openresty/openresty/www/sites/zhiyinapp/maintenance.flag
MAINTENANCE_PAGE_DIR=/opt/1panel/apps/openresty/openresty/www/sites/zhiyinapp/maintenance
MAINTENANCE_TEMPLATE_PATH=/home/gitclone/BeingDoing/src/frontend/maintenance.html
NGINX_RELOAD_CMD="docker exec 1Panel-openresty-hjWm nginx -s reload"
BYPASS_COOKIE_NAME=bypass_maintenance

# 账户注销冷存天数（float，0=注销时立即物理清除；继承 .env 时可覆盖）
ACCOUNT_DELETION_RETENTION_DAYS=30
