# BeingDoing 基础配置脱敏示例。
# 使用方法：复制为 .env，并在本机填写实际值；不要提交真实 .env。
# start.sh 会先加载 .env，再用 .env.dev / .env.prod 覆盖。
# 本文件不是完整上线配置，环境差异见对应 *.example 文件。

ARCHITECTURE_MODE=simple
AUDIO_MODE=False

# 公开占位符：必须在本机替换为独立随机密钥，生产至少 32 字符。
# 不要为方便预检而轮换已有生产密钥。
SECRET_KEY=your-secret-key-here-change-in-production

# 模型主要场景由 admin 的 llm_scene_config 管理。
# LLM_FLASH_MODEL 仅是旧回退路径，不建议用它切换当前主要场景模型。
# LLM_FLASH_MODEL=deepseek-v4-flash

# API 密钥只写入本机真实 env；也可由现行 DB-first 配置链路管理。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
