# ==========================================================
# 生产环境覆盖配置
# 用法: ./start.sh start prod
# 加载顺序: .env (base) → .env.prod (覆盖)
# ==========================================================

APP_ENV=production
DEBUG=False
DEBUG_MODE=False

# 数据库（生产请根据实际修改）
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/xunlu

# 前端
FRONTEND_URL=https://xunlu.soulhappylab.com
# 显式指向 prod 域名的后端，与 dev 自动切换
NEXT_PUBLIC_API_URL=https://xunlu.soulhappylab.com
FRONTEND_MODE=production

# Admin 调试（生产环境建议关闭）
ADMIN_DEBUG_POLICY_ENABLED=True
ADMIN_DEBUG_WORKSPACE_ENABLED=True
ADMIN_SANDBOX_ENABLED=True

# 退信扫描（IMAP 配置继承 .env）
BOUNCE_SCAN_CRON="0 3 * * *"

# 维护模式（maintenance.sh 使用）
# ⚠️ 生产环境（xunlu 站点）专用路径，与 .env.dev 的 zhiyinapp 路径不同
# 容器挂载：/opt/1panel/www → 容器内 /www
#   - 脚本写文件用宿主机路径 /opt/1panel/www/sites/xunlu/...
#   - nginx 配置 root 用容器视角 /www/sites/xunlu/...
# 容器名：1Panel-openresty-UpQ6（prod 机，与 dev 机的 1Panel-openresty-hjWm 不同）
# 如果此处留空，maintenance.sh 会自动探测 docker ps 里的 1Panel-openresty-* 容器
MAINTENANCE_FLAG_PATH=/opt/1panel/www/sites/xunlu/maintenance.flag
MAINTENANCE_PAGE_DIR=/opt/1panel/www/sites/xunlu/maintenance
MAINTENANCE_TEMPLATE_PATH=/home/gitclone/BeingDoing/src/frontend/maintenance.html
NGINX_RELOAD_CMD="docker exec 1Panel-openresty-UpQ6 nginx -s reload"
BYPASS_COOKIE_NAME=bypass_maintenance

# 账户注销冷存天数（float，0=注销时立即物理清除；继承 .env 时可覆盖）
ACCOUNT_DELETION_RETENTION_DAYS=30
