# dev 覆盖层脱敏示例。复制为 .env.dev，在本机填写测试侧秘密。
# 真实 .env.dev 已被 Git 忽略；本模板不包含可用凭据。
# 本文件只列环境差异和本次核对项，不是完整业务配置。

APP_ENV=development
DEBUG=True
DEBUG_MODE=True

FRONTEND_URL=https://career.beyondego.me
NEXT_PUBLIC_API_URL=
# 空值是刻意设置：dev 的 robots 全站禁止抓取，sitemap 为空。
NEXT_PUBLIC_SITE_URL=

TEAM_ANALYSIS_EMAIL=openlife.lab@outlook.com

# 使用本机独立测试签名密钥；不得与生产相同。
SECRET_KEY=your-secret-key-here-change-in-production

# 以下秘密在真实 .env.dev 中填写测试侧值；两边均非空时不得与生产相同。
# 暂无独立测试凭据时可留空，对应外部能力不可用，不要复用生产秘密。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=
SMTP_PASS=
BOUNCE_IMAP_PASS=
OSS_ACCESS_KEY_SECRET=

# 已确认的共享支付例外：dev 也使用正式支付宝和 openlife 回调/回跳。
# 因此生产域名不可用时，dev 的 notify/return 也会受影响。
# 这不是沙箱配置；真实支付验收前必须核对 APPID、密钥和账户。
ALIPAY_NOTIFY_URL=https://openlife.beyondego.me/api/v1/payment/notify/alipay
ALIPAY_RETURN_URL=https://openlife.beyondego.me/payment/result
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
