# prod 覆盖层脱敏示例。复制为 .env.prod，在本机填写生产侧秘密。
# 真实 .env.prod 已被 Git 忽略；本模板不包含可用凭据。
# 本文件只列环境差异和本次核对项，不是完整业务配置。

APP_ENV=production
DEBUG=False
DEBUG_MODE=False
REFRESH_COOKIE_SECURE=True

FRONTEND_URL=https://openlife.beyondego.me
NEXT_PUBLIC_API_URL=
# 必须精确匹配；生产构建时用于 canonical、robots 和 sitemap。
NEXT_PUBLIC_SITE_URL=https://openlife.beyondego.me

TEAM_ANALYSIS_EMAIL=openlife.lab@outlook.com

# 保留现有有效生产密钥；如独立配置 refresh 密钥，也至少 32 字符。
SECRET_KEY=your-secret-key-here-change-in-production
REFRESH_TOKEN_SECRET_KEY=

# 以下秘密只填写生产侧值，不得与 dev 相同；不要写入 Git。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
CLAUDE_API_KEY=
QWEN_API_KEY=
SMTP_PASS=
BOUNCE_IMAP_PASS=
OSS_ACCESS_KEY_SECRET=

# 当前正式支付宝配置；dev 按已确认例外也共享这组公开地址。
ALIPAY_NOTIFY_URL=https://openlife.beyondego.me/api/v1/payment/notify/alipay
ALIPAY_RETURN_URL=https://openlife.beyondego.me/payment/result
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
